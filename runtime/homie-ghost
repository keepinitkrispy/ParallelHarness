#!/data/data/com.termux/files/usr/bin/python3
import json, os, pathlib, re, socket, subprocess, sys, time

HOME = pathlib.Path.home()
GHOST = str(HOME / ".local/bin/ghostctl")
DEV = "127.0.0.1:5555"
DAEMON_PORT = 49210
STATE = HOME / ".local/state/gruesome-twosome"
STATE.mkdir(parents=True, exist_ok=True)

APPS = {
    "chatgpt": {
        "package": "com.openai.chatgpt",
        "component": "com.openai.chatgpt/.MainActivity",
        "name": "ChatGPT",
        "workspace_name": "ChatGPT Workspace",
        "workspace_key": "ghost-chatgpt",
        "send_desc": "Send Message",
        "mode": "chatgpt",
    },
    "claude": {
        "package": "com.anthropic.claude",
        "component": "com.anthropic.claude/.mainactivity.MainActivity",
        "name": "Claude",
        "workspace_name": "Claude Workspace",
        "workspace_key": "ghost-claude",
        "send_desc": "Send",
        "mode": "claude",
    },
    "gemini": {
        "package": "com.google.android.googlequicksearchbox",
        "component": "com.google.android.apps.bard/.shellapp.BardEntryPointActivity",
        "name": "Gemini",
        "workspace_name": "Gemini Workspace",
        "workspace_key": "ghost-gemini",
        "send_desc": "Send",
        "mode": "gemini",
    },
}

def app_env(app):
    env = os.environ.copy()
    env["GHOST_NAME"] = app["workspace_name"]
    env["GHOST_KEY"] = app["workspace_key"]
    return env

def sh(*args, timeout=35, env=None):
    return subprocess.check_output(list(args), text=True, timeout=timeout, env=env)

def adb_shell(command, timeout=15):
    return sh("adb", "-s", DEV, "shell", command, timeout=timeout)

def fast(payload, timeout=130):
    s = socket.create_connection(("127.0.0.1", DAEMON_PORT), 2)
    try:
        s.settimeout(timeout)
        s.sendall((json.dumps(payload, ensure_ascii=False) + "\n").encode())
        data = b""
        while not data.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            data += chunk
    finally:
        s.close()
    result = json.loads(data.decode())
    if not result.get("ok"):
        raise RuntimeError(result.get("error", "ghost daemon request failed"))
    return result
def ensure_daemon():
    try:
        fast({"op": "health"}, timeout=2)
        return
    except Exception:
        pass
    service = "/data/data/com.termux/files/usr/var/service/ghost-ui-daemon"
    if pathlib.Path(service).is_dir():
        subprocess.run(["sv", "up", service], check=False, timeout=5)
    deadline = time.monotonic() + 4
    while time.monotonic() < deadline:
        try:
            fast({"op": "health"}, timeout=1)
            return
        except Exception:
            time.sleep(.1)
    raise RuntimeError("resident UI observer unavailable")

def display_file(which):
    return STATE / ("workspace-" + which + ".display")


def display_exists(display):
    try:
        raw = adb_shell("cmd display get-displays -i", timeout=4)
        return str(display) in {line.strip() for line in raw.splitlines()}
    except Exception:
        return False


def workspace_display(which, app):
    path = display_file(which)
    try:
        display = int(path.read_text().strip())
        if display > 0 and display_exists(display):
            return display
    except Exception:
        pass
    status = sh(GHOST, "start", env=app_env(app), timeout=15)
    match = re.search(r"display=(\d+)", status)
    if not match:
        raise RuntimeError(app["name"] + " workspace has no display")
    display = int(match.group(1))
    if display == 0:
        raise RuntimeError("physical display prohibited")
    path.write_text(str(display) + "\n")
    return display

def snapshot(display, package):
    return fast({"op": "snapshot", "display": display, "package": package}, timeout=3)["nodes"]

def has_composer(display, package):
    return any(n.get("editable") for n in snapshot(display, package))

def wait_composer(display, package, timeout=2.5):
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        try:
            if has_composer(display, package):
                return
        except Exception:
            pass
        time.sleep(.06)
    raise RuntimeError("composer unavailable on isolated display")
def ensure_standard(app, display):
    if has_composer(display, app["package"]):
        return
    subprocess.run(
        ["adb", "-s", DEV, "shell", "am", "start", "--display", str(display),
         "-n", app["component"]],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=8,
    )
    try:
        wait_composer(display, app["package"], timeout=2)
    except Exception:
        sh(GHOST, "launch", app["component"], timeout=20, env=app_env(app))
        wait_composer(display, app["package"])

def gemini_task(force=False):
    cache = STATE / "gemini.task"
    if not force:
        try:
            task = cache.read_text().strip()
            if task.isdigit():
                return task
        except Exception:
            pass
    raw = adb_shell("am stack list", timeout=8)
    match = re.search(
        r"taskId=(\d+): com\.google\.android\.apps\.bard/"
        r"com\.google\.android\.apps\.bard\.shellapp\.BardEntryPointActivity",
        raw,
    )
    task = match.group(1) if match else None
    if task:
        cache.write_text(task + "\n")
    return task

def move_gemini(task, display):
    if not task:
        return
    subprocess.run(
        ["adb", "-s", DEV, "shell", "am", "display", "move-stack", task, str(display)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=5,
    )

def ensure_gemini(display, fresh=True):
    task = gemini_task()
    if not task:
        subprocess.run(
            ["adb", "-s", DEV, "shell", "am", "start", "--display", str(display),
             "-n", APPS["gemini"]["component"]],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=8,
        )
        time.sleep(.15)
        task = gemini_task()
    move_gemini(task, display)
    try:
        wait_composer(display, APPS["gemini"]["package"], timeout=1.8)
    except Exception:
        task = gemini_task(force=True)
        move_gemini(task, display)
        wait_composer(display, APPS["gemini"]["package"], timeout=3)
    if fresh:
        fast({
            "op": "click_desc", "display": display,
            "package": APPS["gemini"]["package"], "description": "New chat",
        }, timeout=3)
        time.sleep(.08)
        move_gemini(task, display)
        try:
            wait_composer(display, APPS["gemini"]["package"], timeout=1.8)
        except Exception:
            task = gemini_task(force=True)
            move_gemini(task, display)
            wait_composer(display, APPS["gemini"]["package"], timeout=3)
def ask(which, prompt):
    app = APPS[which]
    ensure_daemon()
    display = workspace_display(which, app)
    if which == "gemini":
        ensure_gemini(display, fresh=True)
        fresh = "NOOP"
    else:
        ensure_standard(app, display)
        fresh = "New chat"
    result = fast({
        "op": "chat",
        "display": display,
        "package": app["package"],
        "mode": app["mode"],
        "prompt": prompt,
        "send_desc": app["send_desc"],
        "new_chat_desc": fresh,
        "timeout_ms": 120000,
    }, timeout=125)
    return {
        "speaker": app["name"],
        "text": result["text"],
        "elapsed_ms": result.get("elapsed_ms"),
        "display": display,
        "transport": "resident_ui_observer",
    }

if __name__ == "__main__":
    if len(sys.argv) < 3 or sys.argv[1] not in APPS:
        raise SystemExit("usage: homie-ghost chatgpt|claude|gemini PROMPT")
    prompt = sys.argv[2]
    if len(prompt) > 12000:
        raise SystemExit("prompt too long")
    print(json.dumps(ask(sys.argv[1], prompt), ensure_ascii=False))
