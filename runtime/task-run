#!/data/data/com.termux/files/usr/bin/python3
import datetime, fcntl, json, os, pathlib, signal, socket, subprocess, sys, time, uuid, urllib.request
from contextlib import contextmanager
if len(sys.argv) < 7 or sys.argv[5] != '--':
    raise SystemExit('usage: task-run TASK WHY CURRENT_STEP VERIFIED_RESULT -- COMMAND [ARGS...]')
task, why, step, result = sys.argv[1:5]; command=sys.argv[6:]
home=pathlib.Path.home();root=home/'.local/state/capability-cartographer/tasks'
root.mkdir(parents=True,exist_ok=True)
token=uuid.uuid4().hex; file=root/(token+'.json')
notify=str(home/'.local/bin/task-status')
@contextmanager
def state_guard():
    with (root/(token+'.lock')).open('a') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX)
        try: yield
        finally: fcntl.flock(lock,fcntl.LOCK_UN)
def save_unlocked(state):
    temp=file.with_suffix('.tmp');temp.write_text(json.dumps(state,ensure_ascii=False));os.replace(temp,file)
def load_unlocked():return json.loads(file.read_text())
def save(state):
    with state_guard(): save_unlocked(state)
def load():
    with state_guard(): return load_unlocked()
def start_server():
    try:
        with urllib.request.urlopen('http://127.0.0.1:49173/health',timeout=.5) as resp:
            if resp.read()!=b'task-review-ready':raise RuntimeError('Review port belongs to another service')
            return
    except (OSError,urllib.error.URLError):pass
    log=(root/'review-server.log').open('ab')
    subprocess.Popen([str(home/'.local/bin/task-review-server')],stdout=log,stderr=log,
                     start_new_session=True,stdin=subprocess.DEVNULL)
    for _ in range(30):
        time.sleep(.1)
        try:
            with urllib.request.urlopen('http://127.0.0.1:49173/health',timeout=.3) as resp:
                if resp.read()==b'task-review-ready':return
        except (OSError,urllib.error.URLError):pass
    raise RuntimeError('Task review service could not start')
require_approval=os.environ.get('TASK_REQUIRE_APPROVAL')=='1'
workspace=os.environ.get('TASK_WORKSPACE','system').strip().lower()
if workspace not in ('chatgpt','claude','system'): workspace='system'
agent=os.environ.get('TASK_AGENT','').strip() or {'chatgpt':'ChatGPT','claude':'Claude'}.get(workspace,'System')
initial_status='awaiting_approval' if require_approval else 'preparing'
state={'token':token,'task':task,'why':why,'current':step,'expected_result':result,'status':initial_status,
       'workspace':workspace,'agent':agent,
       'events':[f'Started: {why}',f'Current: {step}'],'pause_requested':False,'decision':None}
save(state);start_server()
def status(kind,detail):
    subprocess.run([notify,kind,task,detail,token],check=True,timeout=18)
if require_approval:
    status('start',f'{why} Approval required before: {step} Tap for details and Approve / Deny.')
    while True:
        state=load()
        if state.get('decision') in ('deny','stop') or state.get('status') in ('denied','stopped'):
            detail='Stopped by Ryan.' if state.get('decision')=='stop' or state.get('status')=='stopped' else 'Denied by Ryan before execution.'
            status('done',detail)
            sys.exit(125)
        if state.get('decision')=='approve':
            break
        time.sleep(.25)
else:
    status('start',f'{why} Current: {step} Tap to pause, inspect, or stop.')
try:
    while True:
        wait_for_review=False; denied=False
        with state_guard():
            state=load_unlocked()
            if state.get('decision')=='stop' or state.get('status')=='stopped' or state.get('stop_requested'):
                state['status']='stopped';state['decision']='stop'
                state['current']='Stopped by Ryan.'
                if not state['events'] or state['events'][-1] != state['current']: state['events'].append(state['current'])
                save_unlocked(state);denied=True
            elif state.get('cancel_requested') or state.get('decision')=='deny' or state.get('status')=='denied':
                state['status']='denied';state['decision']='deny'
                state['current']='Denied by Ryan before execution.'
                save_unlocked(state);denied=True
            elif state.get('pause_requested'):
                state['status']='preparing'
                state['current']='Paused before execution because you opened the task.'
                save_unlocked(state);wait_for_review=True
            else:
                child=subprocess.Popen(command,start_new_session=True,env={**os.environ,"TASK_REVIEW_TOKEN":token,"TASK_RESULT_FILE":str(file.with_suffix('.result'))})
                state['pid']=child.pid
                state['proc_start']=pathlib.Path(f'/proc/{child.pid}/stat').read_text().rsplit(')',1)[1].split()[19]
                state['status']='running'
                save_unlocked(state)
        if denied:
            detail='Stopped by Ryan.' if state.get('status')=='stopped' else 'Denied by Ryan before execution.'
            status('done',detail)
            sys.exit(125)
        if wait_for_review:
            time.sleep(.25)
            continue
        break
    code=child.wait()
    result_file=file.with_suffix('.result')
    with state_guard():
        state=load_unlocked()
        if state.get('status')=='stopped' or state.get('cancel_requested'):
            final_state='stopped';detail='Stopped by Ryan.'
        elif state.get('status')=='denied' or state.get('decision')=='deny':
            final_state='denied';detail='Denied by Ryan; task stopped.'
        else:
            final_state='completed' if code==0 else 'failed'
            if code==0 and result_file.exists():result=result_file.read_text().strip() or result
            detail=result if code==0 else f'Exited with status {code}; result unverified.'
        state['status']=final_state;state['current']=detail
        if not state['events'] or state['events'][-1] != detail: state['events'].append(detail)
        save_unlocked(state)
    if final_state=='stopped':
        status('done',detail);sys.exit(125)
    if final_state=='denied':
        status('done',detail);sys.exit(125)
    status('done' if code==0 else 'failed',detail)
    sys.exit(code)
except Exception as exc:
    with state_guard():
        state=load_unlocked();state['status']='failed';state['current']=str(exc)
        state['events'].append(state['current']);save_unlocked(state)
    status('failed',state['current'])
    raise

