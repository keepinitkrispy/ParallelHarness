#!/data/data/com.termux/files/usr/bin/python3
import json,subprocess,pathlib,datetime,sys
h=pathlib.Path.home();ui=json.loads(subprocess.check_output([str(h/'.local/bin/ghostui'),'dump'],text=True))
texts=list(dict.fromkeys(n['text'] for n in ui['nodes'] if n['visible'] and n['text']))
packages=sorted(set(n['package'] for n in ui['nodes'] if n['package']))
record={'capability_id':'ghost.catalog.snapshot','verification_time':datetime.datetime.now(datetime.timezone.utc).isoformat(),'mechanism':'virtual_ui','display':ui['display'],'providers':packages,'texts':texts,'source_urls':[t for t in texts if t.startswith('https://github.com/')],'verified':'observed UI content; candidate claims not execution-tested'}
d=h/'.local/state/capability-cartographer';d.mkdir(exist_ok=True)
with (d/'catalog-discoveries.jsonl').open('a') as f:f.write(json.dumps(record)+'\n')
print(json.dumps(record,ensure_ascii=False))
