#!/data/data/com.termux/files/usr/bin/python3
import json,subprocess,pathlib,datetime,sys,os
h=pathlib.Path.home()
if '--collect' not in sys.argv:
    os.execv(str(h/'.local/bin/task-run'),[str(h/'.local/bin/task-run'),
        'Hidden app discovery',
        'Find reusable capabilities in the app open on the hidden display.',
        'Reading the app UI and checking its source and permissions.',
        'The app snapshot was recorded.',
        '--',sys.executable,__file__,'--collect'])
ui=json.loads(subprocess.check_output([str(h/'.local/bin/ghostui'),'dump'],text=True,timeout=35))
texts=list(dict.fromkeys(n['text'] for n in ui['nodes'] if n['visible'] and n['text']))
packages=sorted(set(n['package'] for n in ui['nodes'] if n['package']))
if not texts:raise RuntimeError('No visible app details to record')
urls=[t for t in texts if t.startswith('https://github.com/')]
record={'capability_id':'ghost.catalog.snapshot',
        'verification_time':datetime.datetime.now(datetime.timezone.utc).isoformat(),
        'mechanism':'virtual_ui','display':ui['display'],
        'providers':packages,'texts':texts,'source_urls':urls,
        'verified':'observed UI content; candidate claims not execution-tested'}
d=h/'.local/state/capability-cartographer';d.mkdir(exist_ok=True)
with (d/'catalog-discoveries.jsonl').open('a') as f:f.write(json.dumps(record)+'\n')
app=texts[0];version=next((t for t in texts if ' · GitHub' in t),'version unlisted')
permission=next((t for t in texts if ' permission' in t),'permissions unlisted')
source=urls[0] if urls else 'no source link shown'
result=f'Recorded {app}: {version}; {permission}; source {source}.'
path=os.environ.get('TASK_RESULT_FILE')
if path:pathlib.Path(path).write_text(result)
print(json.dumps(record,ensure_ascii=False))

