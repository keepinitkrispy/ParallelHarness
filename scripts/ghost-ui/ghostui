 field,value=requested[1:3];pkg=requested[3] if len(requested)>3 else ''
 matches=[n for n in obj['nodes'] if n.get(field)==value and n['visible'] and n['enabled'] and (not pkg or n['package']==pkg)]
 if len(matches)!=1:raise SystemExit('Selector must be unique; matches='+str(len(matches)))
 n=matches[0];x1,y1,x2,y2=n['bounds']
 if x2<=x1 or y2<=y1:raise SystemExit('Empty bounds')
 run(['adb','-s',dev,'shell','input','-d',display,'tap',str((x1+x2)//2),str((y1+y2)//2)])
 obj={'display':int(display),'action':'semantic-tap','selector':dict(field=field,value=value,package=pkg),'bounds':n['bounds'],'injected':True}
if requested[0]!='dump':
 after=tasks();escaped=[]
 for task,old in before.items():
  if old['display']==display and task in after and after[task]['display']!=display:
   run(['adb','-s',dev,'shell','am','display','move-stack',task,display]);escaped.append(task)
 obj['escaped_tasks_recovered']=escaped
 obj['no_task_escape_observed']=not escaped
 if escaped:obj['warning']='Task left ghost display; recovered. This navigation route is not display-safe.'
print(json.dumps(obj,ensure_ascii=False))
