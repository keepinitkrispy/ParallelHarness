import subprocess,json,re,shlex,sys,pathlib,fcntl
h=pathlib.Path.home(); lock=open(h/'.local/state/ghost/ui.lock','w');fcntl.flock(lock,fcntl.LOCK_EX)
def run(a):return subprocess.check_output(a,text=True,timeout=25)
status=run([str(h/'.local/bin/ghostctl'),'status']);m=re.search(r'display=(\d+)',status)
if not m:raise SystemExit('Ghost display is not running')
display=m[1]
if display=='0':raise SystemExit('Physical display prohibited')
devs=run(['adb','devices']);dev=next((l.split()[0] for l in devs.splitlines()[1:] if '\tdevice' in l),None)
if not dev:raise SystemExit('No ADB device')
args=sys.argv[1:] or ['dump']
if args[0] not in ('dump','click','set-text'):raise SystemExit('ghostui dump | click FIELD VALUE [PACKAGE] | set-text FIELD VALUE PACKAGE TEXT')
def tasks():
 raw=run(['adb','-s',dev,'shell','am','stack','list']);result={}
 for block in raw.split('RootTask ')[1:]:
  m=re.search(r'id=(\d+).*?displayId=(\d+)',block)
  if m:result[m[1]]={'display':m[2],'top':re.search(r'topActivity=ComponentInfo\{([^}]+)',block).group(1) if 'topActivity=ComponentInfo{' in block else ''}
 return result
before=tasks() if args[0]!='dump' else {}
