#!/data/data/com.termux/files/usr/bin/python3
import html, json, os, pathlib, re, signal
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse

ROOT = pathlib.Path.home()/'.local/state/capability-cartographer/tasks'
ROOT.mkdir(parents=True, exist_ok=True)
VALID = re.compile(r'^[0-9a-f]{32}$')
def path(token):
    if not VALID.fullmatch(token): raise ValueError('bad task token')
    return ROOT/(token+'.json')
def read(token): return json.loads(path(token).read_text())
def save(token, state):
    target=path(token); tmp=target.with_suffix('.tmp')
    tmp.write_text(json.dumps(state,ensure_ascii=False)); os.replace(tmp,target)
def identity(pid):
    try: return pathlib.Path(f'/proc/{pid}/stat').read_text().rsplit(')',1)[1].split()[19]
    except (OSError,IndexError): return None
def pause(state):
    if state['status'] == 'running':
        pid=state.get('pid')
        if pid and identity(pid)==state.get('proc_start'):
            os.killpg(pid,signal.SIGSTOP); state['status']='paused'
            state['current']='Paused because you opened the task.'
        else: state['status']='finished'
    elif state['status']=='preparing':
        state['pause_requested']=True
        state['current']='Pause requested; work will stop as it starts.'
    return state
def resume(state):
    if state['status']=='paused':
        pid=state.get('pid')
        if pid and identity(pid)==state.get('proc_start'):
            os.killpg(pid,signal.SIGCONT); state['status']='running'
            state['current']='Resumed after your review.'
    elif state['status']=='preparing':
        state['pause_requested']=False
    return state
def render(state,token):
    esc=html.escape
    status=esc(state['status']); title=esc(state['task'])
    why=esc(state['why']); current=esc(state.get('current',''))
    history=''.join('<li>'+esc(e)+'</li>' for e in state.get('events',[])[-15:])
    button=(f'<form method="POST" action="/resume/{token}"><button>Resume task</button></form>'
            if state['status'] in ('paused','preparing') else '')
    return f'''<!doctype html><html><meta name="viewport" content="width=device-width, initial-scale=1">
    <style>body{{font:18px system-ui;margin:24px;line-height:1.5;max-width:700px}}
    h1{{font-size:1.5em}}button{{font-size:1em;padding:12px 20px}}</style>
    <h1>{title}</h1><p><b>Status:</b> {status}</p><p><b>Why:</b> {why}</p>
    <p><b>Current:</b> {current}</p>{button}<h2>Updates</h2><ul>{history}</ul>
    <p><a href="/view/{token}">Refresh status</a></p></html>'''
class Handler(BaseHTTPRequestHandler):
    def reply(self, code, body):
        data=body.encode();self.send_response(code)
        self.send_header('Content-Type','text/html; charset=utf-8')
        self.send_header('Content-Length',str(len(data)));self.end_headers();self.wfile.write(data)
    def route(self, action):
        parts=urlparse(self.path).path.strip('/').split('/')
        if len(parts)!=2 or parts[0] not in ('task','view','resume'): return self.reply(404,'Unknown task')
        kind, token=parts
        try: state=read(token)
        except (ValueError,FileNotFoundError,json.JSONDecodeError): return self.reply(404,'Unknown task')
        if action=='GET' and kind=='task':
            state=pause(state);save(token,state)
        elif action=='POST' and kind=='resume':
            state=resume(state);save(token,state)
        elif not (action=='GET' and kind=='view'): return self.reply(405,'Method not allowed')
        return self.reply(200,render(state,token))
    def do_GET(self):
        if self.path=='/health':return self.reply(200,'task-review-ready')
        self.route('GET')
    def do_POST(self):
        if int(self.headers.get('Content-Length','0'))>0: self.rfile.read(int(self.headers['Content-Length']))
        self.route('POST')
    def log_message(self,*args): pass
ThreadingHTTPServer(('127.0.0.1',49173),Handler).serve_forever()

